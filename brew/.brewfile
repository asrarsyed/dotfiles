#<- Active Taps ->
tap "buo/cask-upgrade", trusted: true            # Best for manually updating GUI apps (casks) with more control
tap "TheBoredTeam/boring-notch", trusted: true   # required for boring-notch
tap "felixkratz/formulae", trusted: true         # required for borders
tap "stefanlogue/tools", trusted: true           # required for meteor
tap "nikitabobko/tap", trusted: true             # required for aerospace
tap "lhvy/tap", trusted: true                    # required for pipes-rs


# <- Essential Binaries ->
brew "git"                        # Distributed revision control system
brew "mas"                        # Command-line interface for the Mac App Store
brew "curl"                       # Gets a file from an HTTP, HTTPS or FTP server
brew "stow"                       # Symlink farm manager that organizes dotfiles under a single directory

# <- Programming Relevant ->
brew "uv"                         # Extremely fast Python package installer and resolver
brew "fnm"                        # Fast and simple Node.js version manager
brew "pass"                       # The standard unix password manager
brew "colima"                     # Container runtimes on MacOS (and Linux) with minimal setup
brew "docker"                     # Pack, ship and run any application as a lightweight container
brew "direnv"                     # Load/unload environment variables based on $PWD
cask "postman"                    # Collaboration platform for API development
cask "miniforge"                  # Minimal installer for conda specific to conda-forge
brew "pinentry-mac"               # Pinentry for GPG on Mac
brew "docker-compose"             # Isolated development environments using Docker


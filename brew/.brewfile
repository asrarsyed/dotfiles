# <- Active Apps ->
cask "aerospace"                  # i3-like tiling window manager for macos
cask "localsend"                  # open-source cross-platform alternative to airdrop
cask "obsidian"                   # private and flexible writing app stored locally
cask "ghostty"                    # terminal emulator that uses platform-native ui and gpu acceleration
cask "alfred"                     # application launcher and productivity software
cask "maccy"                      # clipboard manager for macos
cask "trex"                       # easy to use text extraction tool
cask "thaw"                       # hide menu bar items to give your mac a cleaner look


#<- Active Taps ->
tap "buo/cask-upgrade", trusted: true            # Best for manually updating GUI apps (casks) with more control
tap "nikitabobko/tap", trusted: true             # required for aerospace

# <- Essential Binaries ->
brew "git"                        # Distributed revision control system
brew "mas"                        # Command-line interface for the Mac App Store
brew "curl"                       # Gets a file from an HTTP, HTTPS or FTP server
brew "stow"                       # Symlink farm manager that organizes dotfiles under a single directory

# <- Programming Relevant ->
brew "uv"                         # Extremely fast Python package installer and resolver
cask "postman"                    # Collaboration platform for API development

# <- Inactive Programming Relevant ->


# <- Active "Everyday" Binaries ->
brew "git-delta"                  # syntax-highlighting pager for git and diff output
brew "starship"                   # cross-shell prompt for astronauts
brew "diffnav"                    # git diff pager based on delta but with a file tree
brew "ripgrep"                    # search tool like grep and the silver searcher
brew "neovim"                     # ambitious vim-fork focused on extensibility and agility
brew "zoxide"                     # shell extension to navigate your filesystem faster
brew "trash"                      # command-line tool that moves files or folder to the trash
brew "atuin"                      # improved shell history for zsh, bash, fish and nushell
brew "tmux"                       # terminal multiplexer
brew "bat"                        # syntax highlighting with git integration
brew "eza"                        # modern replacement for ls
brew "fzf"                        # command-line fuzzy finder written in go
brew "fd"                         # simple, fast and user-friendly alternative to find

# <- Active "Occasional" Binaries ->
brew "superfile"                  # modern and pretty fancy file manager for the terminal
brew "btop"                       # resource monitor c++ version (Choose 1: btop/neohtop)
brew "glow"                       # render markdown on the cli


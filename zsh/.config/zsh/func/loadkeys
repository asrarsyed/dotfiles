# Description: Interactively load API keys from pass into shell or write to .envrc
# Usage: loadkeys
#   Use fzf to select keys from pass store, then choose to load into shell or write to .envrc

loadkeys() {
    emulate -L zsh
    setopt local_options pipe_fail

    # ── Verify dependencies ────────────────────────────────────────────────
    (( $+commands[pass] )) || { print "❌ pass is not installed" >&2; return 1 }
    (( $+commands[fzf] ))  || { print "❌ fzf is not installed" >&2; return 1 }

    # ── Discover keys dynamically from pass ───────────────────────────────
    local -a all_keys
    all_keys=(${(f)"$(pass ls api-keys | grep -E '── |─ ' | sed 's/.*[──] //' | sed 's|^|api-keys/|')"})

    (( ${#all_keys} == 0 )) && { print "❌ No keys found in pass store" >&2; return 1 }

    # ── fzf multi-select ──────────────────────────────────────────────────
    local -a selected_keys
    selected_keys=(${(f)"$(printf '%s\n' "${all_keys[@]}" | fzf \
        --multi \
        --prompt='Select keys (TAB to multi-select): ')"})

    # selected_keys=(${(f)"$(printf '%s\n' "${all_keys[@]}" | fzf \
    #     --multi \
    #     --prompt='Select keys (TAB to multi-select): ' \
    #     --header='TAB = select | ENTER = confirm | ESC = cancel')"})

    (( ${#selected_keys} == 0 )) && { print "Cancelled."; return 0 }

    # ── Ask what to do ─────────────────────────────────────────────────────
    local action
    action=$(printf '%s\n' \
        "1) Load into current shell (session only)" \
        "2) Write to .envrc (direnv — persists per project)" \
        | fzf --prompt='Action: ' --header='Select what to do with keys')

    [[ -z $action ]] && { print "Cancelled."; return 0 }

    # ── Action: load into shell ────────────────────────────────────────────
    if [[ $action == 1* ]]; then
        print ""
        local key var_name value
        for key in $selected_keys; do
            var_name="${${key:t:u}//-/_}_API_KEY"
            value=$(pass $key 2>/dev/null)
            if [[ -n $value ]]; then
                export "${var_name}=${value}"
                print "  ✓ $var_name"
            else
                print "  ❌ Failed to load: $key" >&2
            fi
        done
        print "\nKeys loaded into current shell session."

    # ── Action: write to .envrc ────────────────────────────────────────────
    elif [[ $action == 2* ]]; then
        local envrc=".envrc"

        # Handle existing .envrc
        if [[ -f $envrc ]]; then
            local file_action
            file_action=$(printf '%s\n' \
                "1) Append to existing .envrc" \
                "2) Overwrite existing .envrc" \
                "3) Cancel" \
                | fzf --prompt='.envrc exists: ' --header='Select how to handle existing file')

            [[ -z $file_action || $file_action == 3* ]] && { print "Cancelled."; return 0 }

            [[ $file_action == 2* ]] && print "# API keys managed by pass" >| $envrc
        else
            print "# API keys managed by pass" > $envrc
        fi

        # Write pass references to .envrc
        print "" >> $envrc
        local key var_name
        for key in $selected_keys; do
            var_name="${${key:t:u}//-/_}_API_KEY"
            print "export ${var_name}=\"\$(pass ${key})\"" >> $envrc
            print "  ✓ $var_name → .envrc"
        done

        # Run direnv allow if available
        if (( $+commands[direnv] )); then
            direnv allow . 2>/dev/null
            print "\n✓ .envrc written and direnv allowed."
        else
            print "\n✓ .envrc written. Run 'direnv allow' to activate."
        fi
    fi
}
# Description: Display local and public IP address
# Usage: show-ip

show-ip() {
    emulate -L zsh

    local ip
    ip=$(curl -fs4 --connect-timeout 1 --max-time 2 \
        https://1.1.1.1/cdn-cgi/trace 2>/dev/null \
        | awk -F= '/^ip=/{print $2}')

    print "Public IP: ${ip:-unavailable}"
    print "Local IP: $(ipconfig getifaddr en0)"
}